/** SONI FAST FOOD – small-volume Google Sheets backend.
 * Run setup() manually in Apps Script editor before deployment.
 * Public API supports order requests ONLY. Owner management is intentionally
 * not exposed until proper authenticated admin backend is implemented.
 */
const SFF={TZ:'Asia/Kolkata',TABS:{Settings:['key','value'],Menu:['id','name','category','description','price','emoji','active','stock'],TimeSlots:['slot','active'],DeliveryOrders:['orderId','requestId','createdAt','customerName','mobile','address','landmark','latitude','longitude','accuracy','subtotal','deliveryCharge','total','paymentMode','paymentStatus','orderStatus'],DeliveryOrderItems:['orderId','itemId','name','quantity','unitPrice','lineTotal'],DineRequests:['bookingId','requestId','createdAt','bookingDate','name','mobile','itemId','slot','amount','paymentStatus','status'],AuditLogs:['createdAt','action','reference','notes']}};
function setup(){const props=PropertiesService.getScriptProperties();let id=props.getProperty('SHEET_ID');const ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('SONI FAST FOOD Database');if(!id)props.setProperty('SHEET_ID',ss.getId());Object.entries(SFF.TABS).forEach(([name,headers])=>{let sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1)}});const settings=ss.getSheetByName('Settings');if(settings.getLastRow()===1)[['deliveryEnabled','FALSE'],['dineEnabled','FALSE'],['deliveryRadiusKm','3'],['minOrder','149'],['deliveryBaseCharge','25'],['shopLatitude',''],['shopLongitude','']].forEach(r=>settings.appendRow(r));const menu=ss.getSheetByName('Menu');if(menu.getLastRow()===1)[['pizza','Veg Pizza','Pizza','Cheesy and fresh',199,'🍕','TRUE',20],['burger','Veg Burger','Burger','Crispy and fresh',89,'🍔','TRUE',20],['fries','French Fries','Fries','Golden and crunchy',79,'🍟','TRUE',20],['momo','Steam Momos','Momo','With spicy chutney',99,'🥟','TRUE',20],['sandwich','Grilled Sandwich','Sandwich','Freshly toasted',119,'🥪','TRUE',20]].forEach(r=>menu.appendRow(r));const slots=ss.getSheetByName('TimeSlots');if(slots.getLastRow()===1)[['13:00','TRUE'],['14:00','TRUE'],['19:00','TRUE']].forEach(r=>slots.appendRow(r));Logger.log('Database: '+ss.getUrl());}
function db_(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('Owner must run setup() first');return SpreadsheetApp.openById(id)}
function rows_(sh){const vals=sh.getDataRange().getValues();const h=vals.shift().map(String);return vals.map(row=>Object.fromEntries(h.map((k,i)=>[k,row[i]])))}
function settings_(ss){return Object.fromEntries(rows_(ss.getSheetByName('Settings')).map(r=>[r.key,String(r.value)]))}
function menu_(ss){return rows_(ss.getSheetByName('Menu')).filter(r=>String(r.active).toUpperCase()==='TRUE').map(r=>({id:String(r.id),name:String(r.name),category:String(r.category),description:String(r.description),price:Number(r.price),emoji:String(r.emoji),active:Number(r.stock)>0,stock:Number(r.stock)}))}
function reply_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}
function doGet(){return reply_({ok:true,service:'SONI FAST FOOD API',note:'POST JSON for public requests'})}
function doPost(e){try{if(!e||!e.postData||!e.postData.contents)throw Error('Missing request');if(e.postData.contents.length>15000)throw Error('Request too large');const x=JSON.parse(e.postData.contents);if(x.action==='getPublicConfig'){const ss=db_(),s=settings_(ss);return reply_({ok:true,menu:menu_(ss),slots:rows_(ss.getSheetByName('TimeSlots')).filter(r=>String(r.active).toUpperCase()==='TRUE').map(r=>String(r.slot)),deliveryEnabled:s.deliveryEnabled==='TRUE',dineEnabled:s.dineEnabled==='TRUE'})}if(x.action==='createDeliveryOrder')return reply_(createDelivery_(x));if(x.action==='createDineRequest')return reply_(createDine_(x));throw Error('Unknown public action')}catch(err){return reply_({ok:false,error:String(err.message||err)})}}
function required_(v,max){const s=String(v||'').trim();if(!s||s.length>max)throw Error('Missing or invalid required field');return s}
function mobile_(v){const s=String(v||'');if(!/^[6-9][0-9]{9}$/.test(s))throw Error('Invalid Indian mobile number');return s}
function idempotent_(sh,key){return rows_(sh).find(r=>String(r.requestId)===key)}
function requestId_(x){const v=required_(x,100);if(!/^[a-zA-Z0-9-]{16,100}$/.test(v))throw Error('Invalid request ID');return v}
function distanceKm_(a,b,c,d){const rad=x=>x*Math.PI/180;const dl=rad(c-a),dn=rad(d-b),h=Math.sin(dl/2)**2+Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(dn/2)**2;return 6371*2*Math.asin(Math.sqrt(h))}
function createDelivery_(x){const lock=LockService.getScriptLock();lock.waitLock(25000);try{const ss=db_(),s=settings_(ss);if(s.deliveryEnabled!=='TRUE')throw Error('Home delivery is currently closed');const sh=ss.getSheetByName('DeliveryOrders'),key=requestId_(x.requestId),prior=idempotent_(sh,key);if(prior)return{ok:true,orderId:prior.orderId,total:Number(prior.total),status:prior.orderStatus};const c=x.customer||{},name=required_(c.name,80),mobile=mobile_(c.mobile),address=required_(c.address,400),landmark=String(c.landmark||'').slice(0,120);const lat=Number(c.lat),lng=Number(c.lng);if(!Number.isFinite(lat)||!Number.isFinite(lng)||Math.abs(lat)>90||Math.abs(lng)>180||!lat&&!lng)throw Error('Valid GPS pin required');const shopLat=Number(s.shopLatitude),shopLng=Number(s.shopLongitude);if(!s.shopLatitude||!s.shopLongitude)throw Error('Shop GPS is not configured');const km=distanceKm_(lat,lng,shopLat,shopLng);if(km>Number(s.deliveryRadiusKm||3))throw Error('Delivery address is outside our service area');const requested=Array.isArray(x.items)?x.items:[];if(!requested.length||requested.length>30)throw Error('Invalid cart');const m=menu_(ss),line=[],seen=new Set();for(const v of requested){const id=required_(v.id,80),q=Number(v.quantity);if(!Number.isInteger(q)||q<1||q>20||seen.has(id))throw Error('Invalid item quantity');seen.add(id);const i=m.find(i=>i.id===id);if(!i||!i.active||i.stock<q)throw Error('Item unavailable or insufficient stock: '+id);line.push({id,name:i.name,quantity:q,unitPrice:i.price,lineTotal:i.price*q})}const subtotal=line.reduce((a,v)=>a+v.lineTotal,0);if(subtotal<Number(s.minOrder||0))throw Error('Minimum order amount is ₹'+s.minOrder);const charge=Number(s.deliveryBaseCharge||0);if(!Number.isFinite(charge)||charge<0)throw Error('Invalid delivery charge configuration');const mode=String(x.paymentMode);if(!['COD','UPI_MANUAL'].includes(mode))throw Error('Invalid payment mode');const id='SFF-D-'+Utilities.formatDate(new Date(),SFF.TZ,'yyyyMMdd')+'-'+Utilities.getUuid().slice(0,8).toUpperCase();const now=new Date().toISOString();sh.appendRow([id,key,now,name,mobile,address,landmark,lat,lng,Number(c.accuracy)||'',subtotal,charge,subtotal+charge,mode,mode==='COD'?'UNPAID':'PENDING_VERIFICATION','PLACED']);const itemSh=ss.getSheetByName('DeliveryOrderItems');line.forEach(i=>itemSh.appendRow([id,i.id,i.name,i.quantity,i.unitPrice,i.lineTotal]));const menuSh=ss.getSheetByName('Menu');const values=menuSh.getDataRange().getValues();for(const i of line){for(let r=1;r<values.length;r++)if(String(values[r][0])===i.id){menuSh.getRange(r+1,8).setValue(Number(values[r][7])-i.quantity);break}}ss.getSheetByName('AuditLogs').appendRow([now,'ORDER_CREATED',id,'Public order request']);return{ok:true,orderId:id,total:subtotal+charge,status:'PLACED'}}finally{lock.releaseLock()}}
function tomorrow_(){const d=Utilities.formatDate(new Date(),SFF.TZ,'yyyy-MM-dd');const parts=d.split('-').map(Number);return Utilities.formatDate(new Date(Date.UTC(parts[0],parts[1]-1,parts[2]+1)), 'UTC','yyyy-MM-dd')}
function createDine_(x){const lock=LockService.getScriptLock();lock.waitLock(25000);try{const ss=db_(),s=settings_(ss);if(s.dineEnabled!=='TRUE')throw Error('Dine-in booking is currently closed');const sh=ss.getSheetByName('DineRequests'),key=requestId_(x.requestId),prior=idempotent_(sh,key);if(prior)return{ok:true,bookingId:prior.bookingId,message:'Existing pending request'};const name=required_(x.name,80),mobile=mobile_(x.mobile),itemId=required_(x.itemId,80),slot=required_(x.slot,30),date=required_(x.date,10);if(date!==tomorrow_())throw Error('Only tomorrow bookings are allowed');if(!rows_(ss.getSheetByName('TimeSlots')).some(r=>String(r.slot)===slot&&String(r.active).toUpperCase()==='TRUE'))throw Error('Invalid slot');const item=menu_(ss).find(i=>i.id===itemId&&i.active);if(!item)throw Error('Item unavailable');if(rows_(sh).some(r=>String(r.mobile)===mobile&&!['REJECTED','CANCELLED'].includes(String(r.status))))throw Error('Mobile already has a booking request');const id='SFF-B-'+Utilities.getUuid().slice(0,10).toUpperCase();sh.appendRow([id,key,new Date().toISOString(),date,name,mobile,itemId,slot,item.price,'PENDING_VERIFICATION','AWAITING_PAYMENT']);return{ok:true,bookingId:id,message:'Request only. No booking is approved until payment verification and owner approval.'}}finally{lock.releaseLock()}}
